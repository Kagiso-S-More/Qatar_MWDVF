
# Automatic text-file handling
* text=auto

# Python and documentation files
*.py text
*.md text
*.txt text
*.csv text
*.yml text
*.yaml text
*.cff text

# Excel workbooks
*.xlsx binary
*.xls binary

# NetCDF climate datasets
*.nc binary

# Figures and images
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary

# PDF documents
*.pdf binary
